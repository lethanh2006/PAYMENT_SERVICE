NODE_ENV=development
PORT=5006

# PostgreSQL riêng của Payment Service.
PAYMENT_DB_HOST=127.0.0.1
PAYMENT_DB_PORT=5433
PAYMENT_DB_USER=postgres
PAYMENT_DB_PASSWORD=123456
PAYMENT_DB_NAME=nrapp
PAYMENT_DB_SSL=false
PAYMENT_DB_RUN_MIGRATIONS=true

# Phải giống PAYMENT_INTERNAL_SECRET tại Gateway.
PAYMENT_INTERNAL_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_PAYMENT_SECRET
PAYMENT_REQUIRE_SIGNATURE=false
PAYMENT_SIGNATURE_MAX_AGE_MS=300000

# PayOS (https://my.payos.vn → Kênh thanh toán). Webhook đăng ký trên PayOS phải là URL HTTPS
# công khai tới Gateway: https://<tên-miền-hoặc-tunnel>/api/payment/webhooks/payos
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Trang PayOS chuyển khách về sau khi trả hoặc huỷ (trang web hay deep link của app).
PAYOS_RETURN_URL=https://nrappuser.thanhlelmtp2006.id.vn/can-tin
PAYOS_CANCEL_URL=https://nrappuser.thanhlelmtp2006.id.vn/can-tin
# 2-6 ký tự; nội dung chuyển khoản là tiền tố này ghép đuôi orderCode, tối đa 9 ký tự.
PAYMENT_CODE_PREFIX=NRP
PAYMENT_INTENT_TTL_MINUTES=15
PAYMENT_EXPIRY_INTERVAL_MS=60000
# Chu kỳ hỏi PayOS trạng thái link chưa chốt, bắt tiền về mà webhook không báo (tối thiểu 10000).
PAYMENT_RECONCILE_INTERVAL_MS=60000
PAYMENT_OUTBOX_INTERVAL_MS=1000
# 0 = retry vô hạn với exponential backoff; số dương = dừng để xử lý thủ công.
PAYMENT_OUTBOX_MAX_ATTEMPTS=0
# false nếu webhook đi qua Gateway; chỉ bật khi Payment là public entry trực tiếp.
PAYMENT_PUBLIC_ENTRY_LOG_REJECTIONS=false

Rabbitmq_Host=127.0.0.1
Rabbitmq_Port=5672
Rabbitmq_Username=guest
Rabbitmq_Password=guest

# Structured log
LOG_LEVEL=info
LOG_FORMAT=pretty
DEPLOYMENT_ENVIRONMENT=development
