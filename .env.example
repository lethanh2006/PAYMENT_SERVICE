NODE_ENV=development
PORT=5006

# PostgreSQL riêng của Payment Service.
PAYMENT_DB_HOST=127.0.0.1
PAYMENT_DB_PORT=5433
PAYMENT_DB_USER=nrapp_payment
PAYMENT_DB_PASSWORD=replace_with_a_long_random_password
PAYMENT_DB_NAME=nrapp_payment
PAYMENT_DB_SSL=false
PAYMENT_DB_RUN_MIGRATIONS=true

# Phải giống PAYMENT_INTERNAL_SECRET tại Gateway.
PAYMENT_INTERNAL_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_PAYMENT_SECRET
PAYMENT_REQUIRE_SIGNATURE=false
PAYMENT_SIGNATURE_MAX_AGE_MS=300000

# Casso Webhook V2. Đặt max age = 0 nếu cần chấp nhận retry/replay hợp lệ
# của Casso; idempotency tài chính vẫn được bảo vệ vĩnh viễn bởi PostgreSQL.
CASSO_WEBHOOK_SECRET=replace_with_casso_webhook_v2_secret
CASSO_WEBHOOK_PREVIOUS_SECRET=
CASSO_SIGNATURE_MAX_AGE_MS=0
CASSO_TIMEZONE_OFFSET=+07:00

VIETQR_BANK_ID=OCB
VIETQR_ACCOUNT_NUMBER=replace_with_bank_account_number
VIETQR_ACCOUNT_NAME=replace_with_bank_account_name
VIETQR_TEMPLATES=compact2
VIETQR_DESCRIPTION_PREFIX=NRAPP PAY
PAYMENT_CODE_PREFIX=NRP
PAYMENT_INTENT_TTL_MINUTES=15
PAYMENT_EXPIRY_INTERVAL_MS=60000
PAYMENT_OUTBOX_INTERVAL_MS=1000
PAYMENT_OUTBOX_MAX_ATTEMPTS=8
# false nếu webhook đi qua Gateway; chỉ bật khi Payment là public entry trực tiếp.
PAYMENT_PUBLIC_ENTRY_LOG_REJECTIONS=false

Rabbitmq_Host=127.0.0.1
Rabbitmq_Port=5672
Rabbitmq_Username=guest
Rabbitmq_Password=guest

# Logging và OpenTelemetry (local chạy collector tại localhost:4318)
LOG_LEVEL=info
LOG_FORMAT=pretty
OTEL_SERVICE_NAME=payment
OTEL_SERVICE_VERSION=0.0.1
DEPLOYMENT_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1
OTEL_METRIC_EXPORT_INTERVAL=15000
OTEL_METRIC_EXPORT_TIMEOUT=10000
OTEL_HTTP_IGNORE_INCOMING_PATHS=/health,/healthz,/ready,/readiness
